# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon
# Usada somente no servidor (server actions / rotas). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# URL pública do app (usada em links /i, /r, /v e QR Codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slug do espaço padrão (MVP com um único espaço por instalação)
NEXT_PUBLIC_ESPACO_PADRAO=porta-cheia-demo

# Segredo para rotas de cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=troque-isto

# Sal para hash de IP (antifraude / LGPD: guardamos hash, não o IP puro, no rate limit)
IP_HASH_SALT=troque-isto-tambem
